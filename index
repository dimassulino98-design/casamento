<script>
// ══ CARROSSEL DE FUNDO (hero) ══
function initHeroCarousel(){
  const container = document.querySelector('.hero-carousel');
  if(!container) return;
  let imgs = Array.from(container.querySelectorAll('img'));
  if(!imgs.length) return;

  // embaralha a ordem a cada carregamento da página
  for(let i = imgs.length - 1; i > 0; i--){
    const j = Math.floor(Math.random() * (i + 1));
    [imgs[i], imgs[j]] = [imgs[j], imgs[i]];
  }
  imgs.forEach(img => container.appendChild(img));

  let i = 0;
  imgs[0].classList.add('active');
  setInterval(()=>{
    imgs[i].classList.remove('active');
    i = (i+1) % imgs.length;
    imgs[i].classList.add('active');
  }, 3000);
}
initHeroCarousel();

// ══ COUNTDOWN ══
function updateCountdown(){
  const diff = new Date('2026-09-27T15:00:00') - new Date();
  if(diff <= 0){
    ['cd-days','cd-hours','cd-mins','cd-secs'].forEach(id => document.getElementById(id).textContent = '0');
    return;
  }
  document.getElementById('cd-days').textContent  = String(Math.floor(diff/86400000)).padStart(2,'0');
  document.getElementById('cd-hours').textContent = String(Math.floor((diff%86400000)/3600000)).padStart(2,'0');
  document.getElementById('cd-mins').textContent  = String(Math.floor((diff%3600000)/60000)).padStart(2,'0');
  document.getElementById('cd-secs').textContent  = String(Math.floor((diff%60000)/1000)).padStart(2,'0');
}
updateCountdown();
setInterval(updateCountdown, 1000);

// ══ COTAS ══
function changeQty(btn, delta) {
  const wrap = btn.closest('.cota-qty-wrap');
  const numEl = wrap.querySelector('.cota-qty-num');
  const card = btn.closest('.cota-card');
  const valorCota = parseInt(card.dataset.valor); // em centavos
  let qty = parseInt(numEl.textContent) + delta;
  if (qty < 1) qty = 1;
  numEl.textContent = qty;
  const total = (valorCota * qty / 100).toFixed(2).replace('.',',');
  card.querySelector('.cota-total').innerHTML = `Total: <strong>R$ ${total}</strong>`;
}

// ══ Gerador de payload PIX (EMV QR Code) ══
function pixPayload(chave, valor, nome, cidade) {
  function f(id, v) {
    const l = v.length.toString().padStart(2,'0');
    return `${id}${l}${v}`;
  }
  function crc16ccitt(s) {
    let c = 0xFFFF;
    for (let i = 0; i < s.length; i++) {
      c ^= s.charCodeAt(i) << 8;
      for (let j = 0; j < 8; j++)
        c = (c & 0x8000) ? ((c << 1) ^ 0x1021) & 0xFFFF : (c << 1) & 0xFFFF;
    }
    return c.toString(16).toUpperCase().padStart(4,'0');
  }

  const nomeClean = nome.normalize('NFD').replace(/[\u0300-\u036f]/g,'').substring(0,25).toUpperCase();
  const cidadeClean = cidade.normalize('NFD').replace(/[\u0300-\u036f]/g,'').substring(0,15).toUpperCase();
  const valorStr = parseFloat(valor).toFixed(2);

  const mai = f('26', f('00','BR.GOV.BCB.PIX') + f('01', chave));
  const body =
    f('00','01') +
    mai +
    f('52','0000') +
    f('53','986') +
    f('54', valorStr) +
    f('58','BR') +
    f('59', nomeClean) +
    f('60', cidadeClean) +
    f('62', f('05','***')) +
    '6304';

  return body + crc16ccitt(body);
}

let currentPixPayload = '';

function presentear(btn) {
  const card = btn.closest('.cota-card');
  const nomePresente = card.dataset.nome;
  const valorCota = parseInt(card.dataset.valor);
  const qty = parseInt(card.querySelector('.cota-qty-num').textContent);
  const total = valorCota * qty;
  const totalReais = (total / 100).toFixed(2);
  const totalFmt = totalReais.replace('.',',');

  document.getElementById('qr-nome').textContent = nomePresente;
  document.getElementById('qr-valor').textContent = `R$ ${totalFmt}`;

  currentPixPayload = pixPayload('+5585981777415', totalReais, 'JOSE GOMES DOS SANTOS FIL', 'FORTALEZA');

  document.getElementById('qr-modal').classList.add('open');
}

function fecharQR() {
  document.getElementById('qr-modal').classList.remove('open');
}

// fecha modal clicando fora
document.getElementById('qr-modal').addEventListener('click', function(e) {
  if (e.target === this) fecharQR();
});

function copyPayload(){
  navigator.clipboard.writeText(currentPixPayload).then(()=>{
    const b = document.getElementById('btn-copy-payload');
    b.textContent='✓ Código copiado!';
    setTimeout(()=>b.textContent='Copiar código PIX completo',2500);
  });
}

function copyPix(){
  navigator.clipboard.writeText('85981777415').then(()=>{
    const b=document.querySelector('.copy-btn');
    b.textContent='✓ Chave copiada!';
    setTimeout(()=>b.textContent='Copiar chave PIX',2500);
  });
}

const obs=new IntersectionObserver(
  es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible');}),{threshold:.08}
);
document.querySelectorAll('.reveal').forEach(r=>obs.observe(r));
