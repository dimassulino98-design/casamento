  .cota-valor { font-family:'Raleway',sans-serif; font-size:.72rem; letter-spacing:.2em; color:var(--navy-mid); font-weight:300; margin-bottom:1rem; }

  .cota-qty-wrap { display:flex; align-items:center; justify-content:center; gap:.8rem; margin-bottom:1.2rem; }
  .cota-qty-btn {
    width:32px; height:32px; border:1px solid var(--cream-mid);
    background:none; font-size:1.1rem; color:var(--navy);
    cursor:pointer; transition:all .2s; display:flex; align-items:center; justify-content:center;
    font-family:'Forum',cursive;
  }
  .cota-qty-btn:hover { background:var(--navy); color:white; border-color:var(--navy); }
  .cota-qty-num { font-family:'Forum',cursive; font-size:1.4rem; color:var(--navy); min-width:24px; }
  .cota-total { font-family:'Raleway',sans-serif; font-size:.78rem; color:var(--navy-mid); font-weight:300; margin-bottom:1.2rem; }

  .btn-presentear {
    background:var(--navy); color:white; border:none;
    padding:.75rem 1.8rem; font-family:'Raleway',sans-serif;
    font-size:.62rem; letter-spacing:.3em; text-transform:uppercase;
    cursor:pointer; transition:all .3s; font-weight:300; width:100%;
  }
  .btn-presentear:hover { background:var(--navy-mid); }

  /* modal QR */
  .qr-modal {
    display:none; position:fixed; inset:0;
    background:rgba(31,45,90,.5); z-index:999;
    align-items:center; justify-content:center; padding:24px;
  }
  .qr-modal.open { display:flex; }
  .qr-box {
    background:var(--white); padding:40px 36px; text-align:center;
    max-width:380px; width:100%; position:relative;
    border:1px solid var(--cream-mid);
  }
