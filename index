  .qr-subtitle { font-family:'Raleway',sans-serif; font-size:.8rem; color:var(--navy-mid); font-weight:300; margin-bottom:1.4rem; line-height:1.7; }
  .qr-img { width:200px; height:200px; margin:0 auto 1.2rem; border:1px solid var(--cream-mid); padding:8px; display:block; }
  .qr-valor { font-family:'Forum',cursive; font-size:1.8rem; color:var(--navy); margin-bottom:.4rem; }
  .qr-chave { font-family:'Raleway',sans-serif; font-size:.75rem; color:var(--navy-mid); font-weight:300; margin-bottom:1rem; }

  /* whatsapp fallback */
